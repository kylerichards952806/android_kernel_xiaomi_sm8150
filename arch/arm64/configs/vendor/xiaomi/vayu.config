# Platform
CONFIG_MACH_XIAOMI_VAYU=y

# Power
CONFIG_BATT_VERIFY_BY_DS28E16=y
CONFIG_BATT_VERIFY_FORCE_VERIFIED=y
CONFIG_ONEWIRE_GPIO=y
CONFIG_BQ2597X_CHARGE_PUMP=y
CONFIG_MI_QC3_PD_POLICY=y

# Networking
# Nothing in the ROM touches tcp_congestion_control or default_qdisc, so the
# kernel default is what the phone runs: cubic on pfifo_fast.  BBR with fq
# pacing behaves better on lossy mobile and Wi-Fi links, and fq_codel keeps
# queueing delay down while something is saturating the link.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y

# Memory
# The defconfig zeroes every heap allocation and every stack frame at
# function entry.  That is real work on every syscall path, and the infoleak
# protection buys little on a single-user phone.  CFI and the shadow call
# stack stay on; only the zeroing goes.
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
CONFIG_INIT_STACK_NONE=y

# Touchscreen
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_NVT_DEBUG_FS=y
