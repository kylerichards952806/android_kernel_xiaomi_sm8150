# Platform
CONFIG_MACH_XIAOMI=y
CONFIG_MACH_XIAOMI_SM8150=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# exFAT
CONFIG_EXFAT_FS=y

# EROFS
CONFIG_EROFS_FS=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_FPC_TEE=y
CONFIG_FINGERPRINT_GOODIX_TA=y

# Haptics
CONFIG_INPUT_AW8697_XM_HAPTIC=y

# IR
CONFIG_IR_SPI=y
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_MEDIA_RC_SUPPORT=y
CONFIG_RC_DEVICES=y

# Frame-Warn
CONFIG_FRAME_WARN=4096

# NFC
CONFIG_NFC_QTI_I2C=y

# Proximity
CONFIG_US_PROXIMITY=y

# Simtray
CONFIG_SIMTRAY_STATUS=y

# spk-id
CONFIG_HAS_IOMEM=y
CONFIG_MFD_SPK_ID=y

# TEE
CONFIG_TRUSTY=y

# Watchdog
CONFIG_QCOM_WATCHDOG_BARK_TIME=20000
CONFIG_QCOM_WATCHDOG_PET_TIME=15000
